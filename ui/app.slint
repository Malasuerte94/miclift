import { Slider, CheckBox, ComboBox, SpinBox, LineEdit, AboutSlint } from "std-widgets.slint";

export global Motion { in-out property <bool> enabled: true; }

component Button inherits Rectangle {
    in property <string> text;
    in property <bool> enabled: true;
    in property <bool> primary;
    in property <bool> danger;
    callback clicked;
    min-width: label.preferred-width + 30px;
    min-height: 36px;
    preferred-width: label.preferred-width + 30px;
    preferred-height: 36px;
    horizontal-stretch: 0;
    vertical-stretch: 0;
    border-radius: 8px;
    border-width: 1px;
    border-color: focus.has-focus ? #a5ffda : root.primary ? #62dba8 : area.has-hover ? #50697b : #304252;
    background: !root.enabled ? #17212b : root.primary ? (area.pressed ? #43bd8a : area.has-hover ? #91ffd0 : #72f1bd) : area.pressed ? #2c4353 : area.has-hover ? #243646 : #1a2936;
    opacity: root.enabled ? 1 : 0.45;
    animate background, border-color, opacity { duration: Motion.enabled ? 120ms : 0ms; easing: ease-out; }
    accessible-role: button;
    accessible-label: root.text;
    accessible-enabled: root.enabled;
    accessible-action-default => { if (root.enabled) { root.clicked(); } }
    forward-focus: focus;
    label := Text {
        text: root.text;
        color: !root.enabled ? #b8c7d5 : root.primary ? #0b2920 : root.danger ? #ffb0aa : #e3edf5;
        font-size: 12px;
        font-weight: root.primary ? 600 : 500;
        horizontal-alignment: center;
        vertical-alignment: center;
        width: parent.width;
        height: parent.height;
        y: area.pressed && root.enabled ? 1px : 0px;
        animate y { duration: Motion.enabled ? 70ms : 0ms; easing: ease-out; }
    }
    focus := FocusScope {
        enabled: root.enabled;
        key-pressed(event) => {
            if (root.enabled && (event.text == Key.Space || event.text == Key.Return)) { root.clicked(); return accept; }
            return reject;
        }
    }
    area := TouchArea { enabled: root.enabled; mouse-cursor: pointer; clicked => { focus.focus(); root.clicked(); } }
}

export struct Band { frequency: float, gain: float, q: float }

component Label inherits Text {
    color: #8b99a9;
    font-size: 12px;
    vertical-alignment: center;
}
component Heading inherits Text {
    color: #edf4fa;
    font-size: 25px;
    font-weight: 600;
}
component Panel inherits Rectangle {
    background: #141d27;
    border-color: #253240;
    border-width: 1px;
    border-radius: 12px;
}
component Page inherits VerticalLayout {
    property <float> reveal: 0;
    init => { reveal = 1; }
    opacity: Motion.enabled ? reveal : 1;
    animate reveal { duration: Motion.enabled ? 170ms : 0ms; easing: ease-out; }
}
component Nav inherits Rectangle {
    in property <string> text;
    in property <bool> selected;
    callback clicked;
    accessible-role: button;
    accessible-label: root.text;
    accessible-action-default => { root.clicked(); }
    forward-focus: focus;
    height: 43px;
    border-radius: 7px;
    background: selected ? #203b35 : touch.has-hover ? #1b2732 : transparent;
    animate background { duration: Motion.enabled ? 140ms : 0ms; easing: ease-out; }
    Rectangle { x: 0px; y: 12px; width: 3px; height: 19px; border-radius: 2px; background: #72f1bd; opacity: root.selected ? 1 : 0; animate opacity { duration: Motion.enabled ? 140ms : 0ms; } }
    Text { x: 16px; text: root.text; color: root.selected ? #72f1bd : #a3b1c0; font-size: 14px; vertical-alignment: center; animate color { duration: Motion.enabled ? 140ms : 0ms; } }
    border-width: focus.has-focus ? 1px : 0px;
    border-color: #72f1bd;
    focus := FocusScope {
        key-pressed(event) => {
            if (event.text == Key.Space || event.text == Key.Return) { root.clicked(); return accept; }
            return reject;
        }
    }
    touch := TouchArea { mouse-cursor: pointer; clicked => { focus.focus(); root.clicked(); } }
}
component Meter inherits Rectangle {
    in property <float> level;
    height: 9px;
    background: #0b121a;
    border-radius: 4px;
    Rectangle { width: parent.width * min(1, max(0, root.level)); border-radius: 4px; background: root.level > 0.92 ? #ffb36c : #72f1bd; }
}

export component MainWindow inherits Window {
    title: "MicLift";
    icon: @image-url("../assets/miclift.png");
    preferred-width: 990px;
    preferred-height: 820px;
    min-width: 900px;
    min-height: 780px;
    background: #0d141d;
    default-font-family: "Segoe UI";
    default-font-size: 14px;
    no-frame: true;
    in-out property <int> page: 0;
    in-out property <float> boost: 100;
    in property <bool> running;
    in property <bool> requested;
    in-out property <bool> muted;
    in-out property <bool> listening;
    in-out property <float> listen-volume: 50;
    in property <[string]> input-names;
    in property <[string]> cable-names;
    in property <[string]> output-names;
    in-out property <int> input-index;
    in-out property <int> cable-index;
    in-out property <int> output-index;
    in property <float> input-level;
    in property <float> output-level;
    in property <string> input-db: "−∞ dBFS";
    in property <string> output-db: "−∞ dBFS";
    in property <string> status-text: "Ready";
    in property <string> timing-text: "Device periods appear when audio starts";
    in property <string> detail-text: "";
    in property <[Band]> bands;
    in property <string> eq-curve;
    in property <float> eq-top-frequency: 20000;
    in-out property <bool> eq-enabled: true;
    in-out property <bool> high-pass;
    in-out property <bool> gate;
    in-out property <float> gate-threshold: -48;
    in-out property <bool> compressor;
    in-out property <float> compressor-threshold: -18;
    in-out property <float> compressor-ratio: 3;
    in-out property <bool> limiter: true;
    in-out property <bool> start-windows;
    in-out property <bool> start-minimized;
    in-out property <bool> start-audio;
    in-out property <bool> close-tray: true;
    in-out property <bool> reduce-motion;
    in property <[string]> profile-names;
    in-out property <int> profile-index;
    in property <bool> profile-modified;
    in property <bool> profile-default;
    in property <bool> can-delete-profile;
    in property <string> default-profile-label;
    in property <string> profile-details;
    in-out property <string> new-profile-name;
    in-out property <bool> pending-profile;
    in property <string> pending-profile-name;
    in-out property <bool> confirm-delete;
    in property <[string]> eq-presets;
    in-out property <int> eq-preset-index;
    in property <string> setup-label: "Open official VB-CABLE setup";
    in property <bool> setup-busy;
    in property <string> version;
    in property <string> notice;
    callback gain-changed(float);
    callback select-input(int);
    callback select-cable(int);
    callback select-output(int);
    callback toggle-audio;
    callback toggle-mute;
    callback toggle-listen;
    callback volume-changed(float);
    callback change-band(int, int, float);
    callback processing(int, float);
    callback preference(int, bool);
    callback preset(string);
    callback select-profile(int);
    callback profile-action(int, string);
    callback setup;
    callback minimize;
    callback close-window;
    callback show-from-instance;

    VerticalLayout {
        spacing: 0;
        Rectangle {
            height: 43px;
            background: #101922;
            HorizontalLayout {
                padding-left: 15px;
                spacing: 8px;
                WindowMoveArea {
                    HorizontalLayout {
                        Image { source: @image-url("../assets/miclift.png"); width: 26px; height: 26px; }
                        Text { text: "MICLIFT"; color: #b8c7d5; font-size: 11px; font-weight: 700; vertical-alignment: center; }
                        Rectangle { horizontal-stretch: 1; background: transparent; }
                    }
                }
                Button { text: "—"; width: 44px; clicked => { root.minimize(); } }
                Button { text: "×"; width: 44px; clicked => { root.close-window(); } }
            }
        }
        HorizontalLayout {
            spacing: 0;
            Rectangle {
                width: 172px;
                background: #101922;
                VerticalLayout {
                    padding: 17px;
                    spacing: 7px;
                    Label { text: "YOUR VOICE, LIFTED"; height: 32px; font-size: 10px; }
                    Nav { text: "Overview"; selected: root.page == 0; clicked => { root.page = 0; } }
                    Nav { text: "Equalizer"; selected: root.page == 1; clicked => { root.page = 1; } }
                    Nav { text: "Processing"; selected: root.page == 2; clicked => { root.page = 2; } }
                    Nav { text: "Profiles"; selected: root.page == 5; clicked => { root.page = 5; } }
                    Nav { text: "Settings"; selected: root.page == 3; clicked => { root.page = 3; } }
                    Rectangle { vertical-stretch: 1; background: transparent; }
                    Label { text: root.running ? "●  ENGINE LIVE" : "○  ENGINE IDLE"; color: root.running ? #72f1bd : #8b99a9; height: 24px; font-size: 10px; }
                    Nav { text: "About"; selected: root.page == 4; clicked => { root.page = 4; } }
                    Label { text: "v" + root.version; font-size: 10px; height: 24px; }
                }
            }
            VerticalLayout {
                padding: 24px;
                spacing: 14px;
                HorizontalLayout {
                    VerticalLayout {
                        spacing: 5px;
                        Heading { text: root.page == 0 ? "Make yourself heard." : root.page == 1 ? "Shape your sound." : root.page == 2 ? "A cleaner signal." : root.page == 3 ? "Set it. Keep it." : root.page == 5 ? "Your sound, saved." : "Small app. Clear voice."; }
                        Label { text: root.page == 0 ? "Real-time microphone boost, with room to spare." : root.page == 1 ? "Five parametric bands. Changes are applied live." : root.page == 2 ? "Lightweight processing. Every effect is optional." : root.page == 3 ? "Devices, startup and background behavior." : root.page == 5 ? "Boost, EQ and processing. Switch your whole setup in a click." : "MicLift · open-source microphone processing for Windows"; }
                    }
                    Rectangle { horizontal-stretch: 1; background: transparent; }
                    Button { text: root.requested ? "Stop audio" : "Start audio"; primary: !root.requested; width: 117px; clicked => { root.toggle-audio(); } }
                }

                if root.page <= 2: Panel {
                    height: 48px;
                    HorizontalLayout {
                        padding-left: 12px; padding-right: 8px; padding-top: 6px; padding-bottom: 6px; spacing: 12px;
                        Label { text: "PROFILE"; font-size: 10px; width: 48px; }
                        ComboBox { model: root.profile-names; current-index <=> root.profile-index; selected(_) => { root.select-profile(self.current-index); } horizontal-stretch: 1; }
                        Label { text: root.profile-modified ? "● Unsaved" : root.profile-default ? "★ Default" : "Saved"; color: root.profile-modified ? #ffca8b : #72f1bd; width: 77px; font-size: 11px; }
                        Button { text: "Manage"; clicked => { root.page = 5; } }
                    }
                }

                if root.page == 0: Page {
                    spacing: 12px;
                    Panel {
                        height: 90px;
                        VerticalLayout {
                            padding: 18px; spacing: 8px;
                            Label { text: "MICROPHONE"; font-size: 10px; }
                            ComboBox { model: root.input-names; current-index <=> root.input-index; selected(_) => { root.select-input(self.current-index); } }
                        }
                    }
                    Panel {
                        height: 214px;
                        VerticalLayout {
                            padding: 20px; spacing: 8px;
                            HorizontalLayout {
                                Label { text: "MICROPHONE BOOST"; font-size: 11px; }
                                Rectangle { horizontal-stretch: 1; background: transparent; }
                                Button { text: root.muted ? "Unmute" : "Mute"; width: 86px; clicked => { root.toggle-mute(); } }
                            }
                            HorizontalLayout {
                                Text { text: round(root.boost) + "%"; color: root.muted ? #8b99a9 : #72f1bd; font-size: 64px; font-weight: 600; }
                                Rectangle { horizontal-stretch: 1; background: transparent; }
                                VerticalLayout {
                                    alignment: center; spacing: 7px;
                                    Label { text: "AMPLIFICATION"; font-size: 10px; horizontal-alignment: right; }
                                    Text { text: (round(root.boost / 10) / 10) + "×"; color: #edf4fa; font-size: 26px; horizontal-alignment: right; }
                                }
                            }
                            Slider { minimum: 0; maximum: 500; value <=> root.boost; changed(value) => { root.gain-changed(value); } }
                            HorizontalLayout {
                                Label { text: "0%"; }
                                Label { text: "100% = original level"; horizontal-alignment: center; }
                                Label { text: "500%"; horizontal-alignment: right; }
                            }
                        }
                    }
                    Panel {
                        height: 82px;
                        HorizontalLayout {
                            padding: 18px; spacing: 25px;
                            VerticalLayout { spacing: 9px; HorizontalLayout { Label { text: "INPUT"; font-size: 10px; } Label { text: root.input-db; horizontal-alignment: right; } } Meter { level: root.input-level; } }
                            VerticalLayout { spacing: 9px; HorizontalLayout { Label { text: "OUTPUT"; font-size: 10px; } Label { text: root.output-db; horizontal-alignment: right; } } Meter { level: root.output-level; } }
                        }
                    }
                    Panel {
                        VerticalLayout {
                            padding: 17px; spacing: 10px;
                            HorizontalLayout {
                                CheckBox { text: "Live Listen"; checked <=> root.listening; toggled => { root.toggle-listen(); } }
                                Label { text: "Hear the processed signal · nothing is recorded"; horizontal-alignment: right; font-size: 11px; }
                            }
                            HorizontalLayout {
                                spacing: 16px;
                                ComboBox { model: root.output-names; current-index <=> root.output-index; selected(_) => { root.select-output(self.current-index); } horizontal-stretch: 2; }
                                Slider { minimum: 0; maximum: 100; value <=> root.listen-volume; changed(value) => { root.volume-changed(value); } }
                                Label { text: round(root.listen-volume) + "%"; width: 37px; horizontal-alignment: right; }
                            }
                        }
                    }
                }

                if root.page == 1: Page {
                    spacing: 15px;
                    HorizontalLayout {
                        CheckBox { text: "Equalizer enabled"; checked <=> root.eq-enabled; toggled => { root.processing(0, self.checked ? 1 : 0); } }
                        Rectangle { horizontal-stretch: 1; background: transparent; }
                        Label { text: root.eq-preset-index < 0 ? "Custom EQ" : "EQ PRESET"; font-size: 10px; }
                        ComboBox { width: 170px; model: root.eq-presets; current-index <=> root.eq-preset-index; selected(name) => { root.preset(name); } }
                    }
                    Panel {
                        height: 120px;
                        Path { x: 15px; y: 10px; width: parent.width - 30px; height: 100px; viewbox-width: 700; viewbox-height: 120; commands: root.eq-curve; stroke: #72f1bd; stroke-width: 2px; }
                    }
                    HorizontalLayout {
                        spacing: 9px;
                        for band[index] in root.bands: Panel {
                            min-width: 0px;
                            horizontal-stretch: 1;
                            VerticalLayout {
                                padding: 12px; spacing: 9px;
                                Label { text: "BAND " + (index + 1); font-size: 10px; }
                                Text { text: (round(band.gain * 10) / 10) + " dB"; color: #72f1bd; font-size: 20px; horizontal-alignment: center; }
                                Slider { minimum: -12; maximum: 12; value: band.gain; orientation: vertical; height: 125px; changed(value) => { root.change-band(index, 1, value); } }
                                Label { text: "FREQUENCY · Hz"; font-size: 9px; }
                                SpinBox { min-width: 0px; minimum: 20; maximum: round(root.eq-top-frequency); value: round(min(band.frequency, root.eq-top-frequency)); edited(value) => { root.change-band(index, 0, value); } }
                                Label { text: "Q · " + (round(band.q * 10) / 10); }
                                Slider { minimum: 0.1; maximum: 12; value: band.q; changed(value) => { root.change-band(index, 2, value); } }
                            }
                        }
                    }
                    Label { text: "EQ presets change only the equalizer. Save the full sound in Profiles."; }
                    Rectangle { vertical-stretch: 1; background: transparent; }
                }

                if root.page == 2: Page {
                    spacing: 15px;
                    Panel { height: 90px; VerticalLayout { padding: 20px; spacing: 9px; CheckBox { text: "High-pass filter · 80 Hz"; checked <=> root.high-pass; toggled => { root.processing(1, self.checked ? 1 : 0); } } Label { text: "Reduce low rumble and desk vibrations."; } } }
                    Panel { height: 130px; VerticalLayout { padding: 20px; spacing: 12px; CheckBox { text: "Noise gate"; checked <=> root.gate; toggled => { root.processing(2, self.checked ? 1 : 0); } } Label { text: "Threshold  " + round(root.gate-threshold) + " dBFS"; } Slider { minimum: -80; maximum: -12; value <=> root.gate-threshold; changed(value) => { root.processing(3, value); } } } }
                    Panel { height: 170px; VerticalLayout { padding: 20px; spacing: 12px; CheckBox { text: "Compressor"; checked <=> root.compressor; toggled => { root.processing(4, self.checked ? 1 : 0); } } HorizontalLayout { Label { text: "Threshold  " + round(root.compressor-threshold) + " dBFS"; } Slider { minimum: -40; maximum: -3; value <=> root.compressor-threshold; changed(value) => { root.processing(5, value); } } } HorizontalLayout { Label { text: "Ratio  " + (round(root.compressor-ratio * 10) / 10) + ":1"; } Slider { minimum: 1; maximum: 10; value <=> root.compressor-ratio; changed(value) => { root.processing(6, value); } } } } }
                    Panel { height: 98px; VerticalLayout { padding: 20px; spacing: 10px; CheckBox { text: "Peak limiter"; checked <=> root.limiter; toggled => { root.processing(7, self.checked ? 1 : 0); } } Label { text: "Control loud peaks without lookahead delay. Recommended with boost."; } } }
                    Rectangle { vertical-stretch: 1; background: transparent; }
                }

                if root.page == 5: Page {
                    spacing: 16px;
                    Panel {
                        height: 235px;
                        VerticalLayout {
                            padding: 22px; spacing: 14px;
                            HorizontalLayout {
                                Label { text: "SAVED PROFILES"; font-size: 11px; }
                                Label { text: root.profile-modified ? "● Unsaved changes" : "All changes saved"; color: root.profile-modified ? #ffca8b : #72f1bd; horizontal-alignment: right; font-size: 11px; }
                            }
                            ComboBox { model: root.profile-names; current-index <=> root.profile-index; selected(_) => { root.select-profile(self.current-index); } }
                            Label { text: root.profile-details; wrap: word-wrap; color: #c4d4e1; }
                            HorizontalLayout {
                                spacing: 10px;
                                Button { text: "Save changes"; primary: true; enabled: root.profile-modified; clicked => { root.profile-action(1, ""); } }
                                Button { text: root.profile-default ? "★ Startup default" : "Make default"; enabled: !root.profile-default && !root.profile-modified; clicked => { root.profile-action(2, ""); } }
                                Rectangle { horizontal-stretch: 1; background: transparent; }
                                Button { text: "Delete"; danger: true; enabled: root.can-delete-profile; clicked => { root.confirm-delete = true; } }
                            }
                            Label { text: root.default-profile-label; font-size: 11px; }
                        }
                    }
                    Panel {
                        height: 155px;
                        VerticalLayout {
                            padding: 22px; spacing: 12px;
                            Label { text: "SAVE AS A NEW PROFILE"; font-size: 11px; }
                            HorizontalLayout {
                                spacing: 12px;
                                LineEdit { text <=> root.new-profile-name; placeholder-text: "e.g. Podcast, Gaming, Late night…"; accepted => { root.profile-action(0, root.new-profile-name); } }
                                Button { text: "Save as new"; enabled: root.new-profile-name != ""; clicked => { root.profile-action(0, root.new-profile-name); } }
                            }
                            Label { text: "Captures your current boost, all five EQ bands and every processing setting."; wrap: word-wrap; font-size: 11px; }
                        }
                    }
                    Label { text: "The default profile loads when MicLift starts. Without one, your last settings resume.\nDevice routing, Live Listen and Windows preferences stay independent."; wrap: word-wrap; }
                    Rectangle { vertical-stretch: 1; background: transparent; }
                }

                if root.page == 3: Page {
                    spacing: 15px;
                    Panel {
                        height: 255px;
                        VerticalLayout {
                            padding: 20px; spacing: 13px;
                            Label { text: "WINDOWS & BACKGROUND"; font-size: 11px; }
                            CheckBox { text: "Start with Windows"; checked <=> root.start-windows; toggled => { root.preference(0, self.checked); } }
                            CheckBox { text: "Start minimized to tray"; checked <=> root.start-minimized; toggled => { root.preference(1, self.checked); } }
                            CheckBox { text: "Start audio automatically"; checked <=> root.start-audio; toggled => { root.preference(2, self.checked); } }
                            CheckBox { text: "Close window to tray"; checked <=> root.close-tray; toggled => { root.preference(3, self.checked); } }
                            CheckBox { text: "Reduce interface motion"; checked <=> root.reduce-motion; toggled => { root.preference(4, self.checked); } }
                        }
                    }
                    Panel {
                        VerticalLayout {
                            padding: 20px; spacing: 12px;
                            Label { text: "VIRTUAL MICROPHONE"; font-size: 11px; }
                            ComboBox { model: root.cable-names; current-index <=> root.cable-index; selected(_) => { root.select-cable(self.current-index); } }
                            Label { text: "In Discord, Teams or your game, select CABLE Output as the microphone."; wrap: word-wrap; }
                            Button { text: root.setup-busy ? "Setup is running…" : root.setup-label; enabled: !root.setup-busy; clicked => { root.setup(); } }
                            Label { text: "VB-CABLE is a separate VB-Audio product. A driver install may require a restart."; wrap: word-wrap; font-size: 11px; }
                        }
                    }
                    Label { text: root.detail-text; wrap: word-wrap; }
                    Rectangle { vertical-stretch: 1; background: transparent; }
                }

                if root.page == 4: Page {
                    spacing: 20px;
                    Panel { height: 370px; VerticalLayout { padding: 25px; spacing: 16px; Heading { text: "MicLift " + root.version; } Label { text: "Microphone boost · 5-band EQ · real-time monitoring"; } Label { text: "Native Rust + WASAPI engine. MIT-licensed application code."; wrap: word-wrap; } Label { text: "No account. No telemetry. No audio recordings."; } HorizontalLayout { AboutSlint { preferred-width: 270px; max-width: 300px; } Rectangle { horizontal-stretch: 1; background: transparent; } } } }
                    Label { text: "Windows 10 22H2 / Windows 11 · x64"; }
                    Rectangle { vertical-stretch: 1; background: transparent; }
                }

                if root.notice != "": Text { text: root.notice; color: #ffca8b; font-size: 12px; wrap: word-wrap; }
                VerticalLayout {
                    spacing: 6px;
                    Text { text: root.status-text; color: root.running ? #72f1bd : #aebdca; font-size: 11px; wrap: word-wrap; }
                    Label { text: root.timing-text; font-size: 10px; wrap: word-wrap; }
                }
            }
        }
    }

    if root.pending-profile || root.confirm-delete: Rectangle {
        background: #050a10cc;
        TouchArea { }
        Panel {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: 540px; height: 226px;
            border-color: #476354;
            VerticalLayout {
                padding: 24px; spacing: 16px;
                Heading { text: root.confirm-delete ? "Delete this profile?" : "Keep your changes?"; font-size: 23px; }
                Label { text: root.confirm-delete ? "This removes the saved profile and its startup default, if set. Your other profiles stay saved." : "You have unsaved changes. Save them before switching to “" + root.pending-profile-name + "”, or discard the edits."; wrap: word-wrap; }
                HorizontalLayout {
                    spacing: 10px;
                    Button { text: "Cancel"; clicked => { root.profile-action(6, ""); } }
                    Rectangle { horizontal-stretch: 1; background: transparent; }
                    if !root.confirm-delete: Button { text: "Discard & switch"; clicked => { root.profile-action(5, ""); } }
                    Button { text: root.confirm-delete ? "Delete profile" : "Save & switch"; primary: !root.confirm-delete; danger: root.confirm-delete; clicked => { root.profile-action(root.confirm-delete ? 3 : 4, ""); } }
                }
            }
        }
    }
}

export component Tray inherits SystemTrayIcon {
    icon: @image-url("../assets/miclift.png");
    tooltip: "MicLift · microphone processor";
    callback show-window;
    callback toggle-audio;
    callback toggle-mute;
    callback quit;
    clicked => { root.show-window(); }
    Menu {
        MenuItem { title: "Show MicLift"; activated => { root.show-window(); } }
        MenuItem { title: "Start / stop audio"; activated => { root.toggle-audio(); } }
        MenuItem { title: "Mute / unmute"; activated => { root.toggle-mute(); } }
        MenuSeparator { }
        MenuItem { title: "Exit"; activated => { root.quit(); } }
    }
}
